---
import '../styles/site.css';

const title = 'Kyle Lucius · 代号 KDL';
const description = 'Kyle Lucius（代号 KDL）的个人主页。关于信息学竞赛、Minecraft 模组开发，以及我用 Python 做过的小实验。';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
  </head>
  <body id="top">
    <a class="skip" href="#main">跳到正文</a>
    <header class="frame masthead">
      <a class="brand" href="#top" aria-label="Kyle Lucius 首页">Kyle Lucius</a>
      <nav aria-label="主导航">
        <a href="#about">关于</a><a href="#archive">归档实验</a><a href="#contact">联系</a>
      </nav>
    </header>
    <main id="main" class="frame" tabindex="-1">
      <section class="hero" aria-labelledby="name">
        <h1 id="name">Kyle Lucius</h1>
        <p class="codename">代号 KDL</p>
        <p class="role">信息学竞赛生 · Minecraft 模组开发者</p>
      </section>
      <section id="about" class="section">
        <h2>关于我</h2>
        <div class="bio">
          <p>你好，我是 Kyle，代号 KDL。</p>
          <p>我参加信息学竞赛，熟悉 Java 和 Python。除了做算法题，我也喜欢给 Minecraft 写模组。</p>
        </div>
      </section>
      <section id="archive" class="section">
        <h2>归档实验</h2>
        <div class="projects">
          <article>
            <div class="project-heading"><h3>CCDabi</h3><small>已归档</small></div>
            <p>一个完全用键盘操作的 Python 游戏。玩家可以选择技能，在结算时查看双方的资源。</p>
            <a href="https://theccking.github.io/manual.html">阅读玩家手册</a>
            <a href="https://theccking.github.io/#ccdabi">项目归档</a>
          </article>
          <article>
            <div class="project-heading"><h3>CCChatroom</h3><small>已归档</small></div>
            <p>用 Python 写的聊天室实验，分为服务端和客户端。两个程序都保存在 CCKing 系列软件归档里。</p>
            <a href="https://theccking.github.io/#ccchatroom">查看聊天室归档</a>
          </article>
        </div>
      </section>
      <section class="section">
        <h2>代码之外</h2>
        <p>我喜欢玩 KARDS 和《实况足球》，也是皇家马德里球迷。</p>
      </section>
    </main>
    <footer id="contact">
      <div class="frame section">
        <h2>联系我</h2>
        <div class="contact-links">
          <a href="mailto:egamer1337@gmail.com">egamer1337@gmail.com</a>
          <a href="https://github.com/kyle-lucius">GitHub / kyle-lucius</a>
          <a href="https://www.luogu.com.cn/user/1022986">洛谷 / 1022986</a>
        </div>
      </div>
    </footer>
  </body>
</html>
