---
import '../styles/site.css';

const name = 'Kyle "KDL" Lucius';
const title = `${name} · Home`;
const description = `${name} Homepage`;
const games = [
  { name: 'KARDS', share: 55, color: 'var(--kards)' },
  { name: '实况足球', share: 40, color: 'var(--efootball)' },
  { name: '其他', share: 5, color: 'var(--other-games)' },
].map((game, index, all) => ({
  ...game,
  offset: all.slice(0, index).reduce((sum, item) => sum + item.share, 0),
}));
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
  </head>
  <body>
    <main class="frame hero">
      <section class="hero-intro" aria-labelledby="name">
        <h1 id="name">{name}</h1>
        <p class="role">OIer · Minecraft Modder</p>
        <p class="hero-summary">解算法题，也为 Minecraft 写模组。</p>
        <figure class="hero-bio" aria-labelledby="quote-title">
          <figcaption id="quote-title">每日格言</figcaption>
          <blockquote data-daily-quote>千里之行，始于足下。</blockquote>
          <p class="quote-credit">
            <cite data-quote-source>《道德经》</cite>
            <a data-quote-link href="https://hitokoto.cn/" hidden>一言</a>
          </p>
        </figure>
        <div class="hero-social">
          <a href="https://github.com/kyle-lucius" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38l-.01-1.49c-2.23.49-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.22.82 1.22.82.71 1.22 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.7 7.7 0 0 1 8 3.73c.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.74-3.65 3.94.29.25.54.73.54 1.48l-.01 2.34c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
            </svg>
          </a>
          <a href="https://www.luogu.com.cn/user/1022986" aria-label="洛谷" title="洛谷">
            <img src="/luogu-icon.png" width="24" height="24" alt="" />
          </a>
          <a href="mailto:egamer1337@gmail.com" aria-label="邮箱" title="邮箱">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          </a>
        </div>
      </section>

      <div class="hero-grid">
        <a class="hero-tile" href="https://theccking.github.io/#ccdabi">
          <span class="tile-status">已归档</span>
          <strong>CCDabi</strong>
          <span>一个完全用键盘操作的 Python 游戏。</span>
        </a>
        <a class="hero-tile" href="https://theccking.github.io/#ccchatroom">
          <span class="tile-status">已归档</span>
          <strong>CCChatroom</strong>
          <span>Python 聊天室实验</span>
        </a>
        <section class="hero-tile game-tile" aria-labelledby="game-title">
          <h2 id="game-title">游戏</h2>
          <div class="game-chart">
            <svg viewBox="0 0 100 100" class="donut" aria-hidden="true">
              <circle class="donut-track" cx="50" cy="50" r="41" />
              {games.map(({ share, offset, color }) => (
                <circle class="donut-segment" cx="50" cy="50" r="41" pathLength="100"
                  transform="rotate(-90 50 50)" style={`--share:${share};--offset:${-offset};--segment:${color}`} />
              ))}
            </svg>
            <ul class="game-legend">
              {games.map(({name, share, color}) => (
                <li style={`--segment:${color}`}><span>{name}</span><b>{share}%</b></li>
              ))}
            </ul>
          </div>
        </section>
        <div class="hero-tile placeholder">
          <span class="tile-status">待填充</span>
          <strong>更多实验</strong>
        </div>
      </div>
    </main>
    <script>
      import { showDailyQuote } from '../scripts/daily-quote';
      void showDailyQuote();
    </script>
  </body>
</html>
