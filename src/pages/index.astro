---
import '../styles/site.css';

const name = 'Kyle "KDL" Lucius';
const title = `${name} · Home`;
const description = `${name} 的个人主页。关于信息学竞赛、Minecraft 模组开发，以及我用 Python 做过的小实验。`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
  </head>
  <body>
    <main class="frame hero">
      <section class="hero-intro" aria-labelledby="name">
        <h1 id="name">{name}</h1>
        <p class="role">信息学竞赛生 · Minecraft 模组开发者</p>
        <div class="hero-bio">
          <p>用 Java 和 Python 解算法题，也为 Minecraft 写模组。</p>
          <p>玩 KARDS 和《实况足球》，支持皇家马德里。</p>
        </div>
        <div class="hero-social">
          <a href="https://github.com/kyle-lucius">GitHub</a>
          <a href="https://www.luogu.com.cn/user/1022986">洛谷</a>
          <a href="mailto:egamer1337@gmail.com">邮箱</a>
        </div>
      </section>

      <div class="hero-grid">
        <a class="hero-tile" href="https://theccking.github.io/#ccdabi">
          <span class="tile-status">已归档</span>
          <strong>CCDabi</strong>
          <span>一个完全用键盘操作的 Python 游戏。</span>
        </a>
        <a class="hero-tile" href="https://theccking.github.io/#ccchatroom">
          <span class="tile-status">已归档</span>
          <strong>CCChatroom</strong>
          <span>Python 聊天室实验</span>
        </a>
        <div class="hero-tile placeholder">
          <span class="tile-status">待填充</span>
          <strong>开发笔记</strong>
        </div>
        <div class="hero-tile placeholder">
          <span class="tile-status">待填充</span>
          <strong>更多实验</strong>
        </div>
      </div>
    </main>
  </body>
</html>
